# cmake_uninstall.cmake — generated, do not edit
if(NOT EXISTS "@CMAKE_CURRENT_BINARY_DIR@/install_manifest.txt")
    message(FATAL_ERROR "No install_manifest.txt found. Run cmake --install first.")
endif()

file(READ "@CMAKE_CURRENT_BINARY_DIR@/install_manifest.txt" _manifest)
string(REGEX REPLACE "\n" ";" _files "${_manifest}")
foreach(_file ${_files})
    if(EXISTS "${_file}")
        message(STATUS "Removing ${_file}")
        file(REMOVE "${_file}")
    else()
        message(STATUS "Skipping (not found): ${_file}")
    endif()
endforeach()

# Remove empty directories (best effort)
set(_dirs)
foreach(_file ${_files})
    get_filename_component(_dir "${_file}" DIRECTORY)
    list(APPEND _dirs "${_dir}")
endforeach()
list(REMOVE_DUPLICATES _dirs)
list(SORT _dirs)
list(REVERSE _dirs)
foreach(_dir ${_dirs})
    file(GLOB _contents "${_dir}/*")
    list(LENGTH _contents _count)
    if(_count EQUAL 0 AND EXISTS "${_dir}")
        message(STATUS "Removing empty directory ${_dir}")
        file(REMOVE_RECURSE "${_dir}")
    endif()
endforeach()
