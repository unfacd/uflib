@PACKAGE_INIT@

get_filename_component(uflib_CMAKE_DIR "${CMAKE_CURRENT_LIST_FILE}" PATH)

include(CMakeFindDependencyMacro)

find_dependency(OpenSSL)

# Valgrind is optional — standard_valgrind_includes.h conditionally includes it.
find_path(VALGRIND_INCLUDE_DIR valgrind/valgrind.h
    HINTS /opt/include /usr/include /usr/local/include
)

list(APPEND CMAKE_MODULE_PATH ${uflib_CMAKE_DIR})

include("${uflib_CMAKE_DIR}/uflibTargets.cmake")

# Create canonical alias uflib::uflib — resolves to whichever target was built.
# BUILD_SHARED_LIBS=ON  → uflib::uflib_shared (preferred, dynamic linking)
# BUILD_SHARED_LIBS=OFF → uflib::uflib_static
if(NOT TARGET uflib::uflib)
    if(TARGET uflib::uflib_shared)
        add_library(uflib::uflib ALIAS uflib::uflib_shared)
    elseif(TARGET uflib::uflib_static)
        add_library(uflib::uflib ALIAS uflib::uflib_static)
    else()
        message(FATAL_ERROR "Neither uflib::uflib_shared nor uflib::uflib_static found in uflibTargets.cmake")
    endif()
endif()

set(uflib_LIBRARIES uflib::uflib)
