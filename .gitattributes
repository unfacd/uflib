# Auto-detect text files and normalize line endings to LF
* text=auto

# Shell scripts must have LF line endings
*.sh text eol=lf

# C/C++ source
*.c text eol=lf
*.h text eol=lf
*.cpp text eol=lf
*.cc text eol=lf

# cmake files
*.cmake text eol=lf
CMakeLists.txt text eol=lf
*.cmake.in text eol=lf

# Assembly
*.S text eol=lf
*.s text eol=lf

# Config
*.cfg text eol=lf
*.conf text eol=lf
*.in text eol=lf

# Docs
*.md text eol=lf
*.html text eol=lf
*.css text eol=lf

# ── tig→github mirror control files: force LF regardless of core.autocrlf ──
# (overrides the `* text=auto` rule above; CRLF here defeats exclusion parsing)
devops/git_mirror_exclusions.txt                text eol=lf
devops/git_last_mirror_commit_ids_registry.txt  text eol=lf
devops/*.sh                                      text eol=lf

# Test fixtures and case tables must have LF.
#
# The truth table is compared field by field and the reader strips '\n' but not
# '\r' (ufconfig_validate.c), so with core.autocrlf=true a fresh clone would
# check these out as CRLF and every row would report a mismatch against an
# expected status carrying a trailing carriage return.  The document parser
# itself tolerates CR; this is about the harness's comparison, not the format.
*.lua text eol=lf
*.tsv text eol=lf

# This file must itself be LF: a CR would enter the patterns.
.gitattributes text eol=lf
