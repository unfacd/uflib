/**
 * @file ufconfig_secrets_paths.h.in
 * @brief Fixture locations for the encrypted-secret tests, resolved at configure
 *        time.
 *
 * CTest runs each test from the build directory, so a path written relative to
 * the source file would be wrong at run time.  Configured rather than guessed,
 * the same way the parent suite's @c ufconfig_test_paths.h is.
 */

#ifndef UFCONFIG_SECRETS_PATHS_H
#define UFCONFIG_SECRETS_PATHS_H

/*! Directory holding the documents and the secrets file this suite loads. */
#define UFCONFIG_SECRETS_FIXTURE_DIR "@CMAKE_CURRENT_SOURCE_DIR@/fixtures"

#endif /* UFCONFIG_SECRETS_PATHS_H */
